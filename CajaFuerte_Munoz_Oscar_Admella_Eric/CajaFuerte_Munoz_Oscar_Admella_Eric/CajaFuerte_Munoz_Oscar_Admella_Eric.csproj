<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- El ejecutable se llama "CajaFuerte" para coincidir con la sintaxis del enunciado -->
    <AssemblyName>CajaFuerte</AssemblyName>
    <RootNamespace>CajaFuerte</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Cualquier aviso del compilador o del analizador se trata como error -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
